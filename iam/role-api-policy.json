{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobsAndCandidates",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Jobs",
        "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Candidates",
        "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Candidates/index/ScoreIndex"
      ]
    },
    {
      "Sid": "SignResumeUploads",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::resumerank-resumes-<SUFFIX>/resumes/*"
    }
  ]
}
