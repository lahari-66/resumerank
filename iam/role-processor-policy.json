{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeUploadQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_ID>:resumerank-queue"
    },
    {
      "Sid": "ReadResumes",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::resumerank-resumes-<SUFFIX>/resumes/*"
    },
    {
      "Sid": "TextractNoResourceLevelPermissions",
      "Effect": "Allow",
      "Action": [
        "textract:StartDocumentTextDetection",
        "textract:GetDocumentTextDetection"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ComprehendNoResourceLevelPermissions",
      "Effect": "Allow",
      "Action": [
        "comprehend:DetectKeyPhrases",
        "comprehend:DetectEntities"
      ],
      "Resource": "*"
    },
    {
      "Sid": "JobsAndCandidates",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Jobs",
        "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/Candidates"
      ]
    },
    {
      "Sid": "AlertTopic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:<ACCOUNT_ID>:resumerank-alerts"
    },
    {
      "Sid": "ScoreMetricNoResourceLevelPermissions",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "ResumeRank"
        }
      }
    }
  ]
}
