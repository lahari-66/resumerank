ap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1013.0" y="798.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c43" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="823.0" y="543.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c44" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="943.0" y="668.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c45" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1193.0" y="668.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;1  Users open the website over HTTPS (Amplify)&lt;br&gt;2  Pages call the API (CORS, throttling)&lt;br&gt;3  API Gateway invokes api_handler&lt;br&gt;4  Jobs, leaderboard, decisions in DynamoDB&lt;br&gt;5  Browser PUTs the PDF with a pre-signed URL&lt;br&gt;6  S3 sends ObjectCreated to the SQS queue&lt;br&gt;7  Lambda scales out to drain the queue (max 5)&lt;br&gt;8  Text + entities (Textract / Comprehend, or pypdf)&lt;br&gt;9  Score written: SCORED or FAILED&lt;br&gt;10  Score ≥ the job's alert threshold publishes an alert&lt;br&gt;11  Recruiter receives the email" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1280" y="790" width="370" height="225" as="geometry"/></mxCell><mxCell id="c47" value="HTTPS via Amplify · private resumes bucket · pre-signed URLs · recruiter access key · CORS limited to the site · Rs. 0 on the AWS Free Tier" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#545B64;align=center;" vertex="1" parent="1"><mxGeometry x="1280" y="380" width="350" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
