              "label": "sent by S3"
            }
          ],
          [
            "AWS/SQS",
            "NumberOfMessagesDeleted",
            "QueueName",
            "resumerank-queue",
            {
              "label": "processed"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
