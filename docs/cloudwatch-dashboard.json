      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 13,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "process_resume concurrent executions (auto scaling)",
        "region": "ap-south-1",
        "stat": "Maximum",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/Lambda",
            "ConcurrentExecutions",
            "FunctionName",
            "process_resume"
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 13,
      "width": 8,
      "height": 6,
      "properties": {
