              "stat": "Average",
              "label": "average"
            }
          ],
          [
            "ResumeRank",
            "CandidateScore",
            {
              "stat": "Maximum",
              "label": "max"
            }
          ],
          [
            "ResumeRank",
            "CandidateScore",
