        "stat": "Sum",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ApiGateway",
            "Count",
            "ApiId",
            "<API_ID>",
            {
              "label": "requests"
            }
          ],
          [
            "AWS/ApiGateway",
            "4xx",
            "ApiId",
            "<API_ID>",
            {
              "label": "4xx (incl. 429)"
            }
          ],
          [
            "AWS/ApiGateway",
            "5xx",
            "ApiId",
            "<API_ID>",
            {
              "label": "5xx"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 19,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "API Gateway latency (ms)",
        "region": "ap-south-1",
        "stat": "Average",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/ApiGateway",
            "Latency",
            "ApiId",
            "<API_ID>",
