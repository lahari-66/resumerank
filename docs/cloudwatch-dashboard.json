          [
            "AWS/SQS",
            "ApproximateNumberOfMessagesNotVisible",
            "QueueName",
            "resumerank-queue",
            {
              "label": "in flight"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
      "y": 13,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "SQS messages sent / processed",
        "region": "ap-south-1",
        "stat": "Sum",
        "period": 60,
        "view": "timeSeries",
        "metrics": [
          [
            "AWS/SQS",
            "NumberOfMessagesSent",
            "QueueName",
            "resumerank-queue",
