# Copy to .env and fill in after the AWS resources exist.
# .env is gitignored. It holds AWS resource NAMES only - never access keys, never a GitHub token.

AWS_REGION=ap-south-1

SITE_BUCKET=resumerank-site-<suffix>
RESUMES_BUCKET=resumerank-resumes-<suffix>

JOBS_TABLE=Jobs
CANDIDATES_TABLE=Candidates
SCORE_INDEX=ScoreIndex

SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:<account-id>:resumerank-alerts

# filled in after the HTTP API is created (Day 1, Hr 3-4)
API_BASE_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com

# recruiter access key: the same value goes into the api_handler environment variable RECRUITER_KEY
RECRUITER_KEY=<long random string>
